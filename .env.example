# Переменные окружения для сервиса ABS Inventory & Procurement Assistant
APP_ENV=development
PORT=8000

# Параметры контейнера PostgreSQL
POSTGRES_USER=abs_user
POSTGRES_PASSWORD=abs_password
POSTGRES_DB=abs_inventory
POSTGRES_PORT=5432

# Строка подключения приложения к основной БД
DATABASE_URL=postgresql+psycopg://abs_user:abs_password@db:5432/abs_inventory

# Строка подключения к отдельной тестовой БД
TEST_DATABASE_URL=postgresql+psycopg://abs_user:abs_password@db:5432/abs_inventory_test
